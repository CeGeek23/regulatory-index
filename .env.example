# Copy to .env and adjust. The pipeline reads these via os.environ when set,
# otherwise falls back to config/settings.yaml defaults.

OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Optional: increase if you have GPU headroom and want better quality
# OLLAMA_MODEL=qwen2.5:7b-instruct
# OLLAMA_MODEL=qwen2.5:14b

# Optional logging
LOG_LEVEL=INFO
